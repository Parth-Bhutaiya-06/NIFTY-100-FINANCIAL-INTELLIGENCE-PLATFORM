    "/api/v1/valuation/rankings/top": {
      "get": {
        "tags": [
          "Valuation"
        ],
        "summary": "Get Valuation Rankings",
        "description": "Rank companies by their latest-year value for a given\nvaluation metric.\n\nRaises:\n    HTTPException: 400 if an unsupported metric is given.",
        "operationId": "get_valuation_rankings_api_v1_valuation_rankings_top_get",
        "parameters": [
          {
            "name": "metric",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "One of: dividend_yield_pct, enterprise_value_crore, ev_ebitda, market_cap_crore, pb_ratio, pe_ratio",
              "default": "market_cap_crore",
              "title": "Metric"
            },
            "description": "One of: dividend_yield_pct, enterprise_value_crore, ev_ebitda, market_cap_crore, pb_ratio, pe_ratio"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(asc|desc)$",
              "default": "desc",
              "title": "Order"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Valuation Rankings Api V1 Valuation Rankings Top Get"
                }
              }
            }
